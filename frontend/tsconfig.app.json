{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "google.maps"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Shared domain logic from the backend (pure TypeScript, no Node/AWS imports) */
    "paths": { "@core/*": ["../backend/src/lib/*"] }
  },
  "include": [
    "src",
    "../backend/src/lib/types.ts",
    "../backend/src/lib/catalog.ts",
    "../backend/src/lib/core.ts",
    "../backend/src/lib/geo.ts",
    "../backend/src/lib/rules.ts",
    "../backend/src/lib/vellore-stations.ts",
    "../backend/src/lib/citizen-view.ts",
    "../backend/src/lib/station-view.ts"
  ]
}
